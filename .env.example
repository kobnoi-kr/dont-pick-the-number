# PostgreSQL connection (required to enable Auth)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/numverse?schema=public"

# Public site URL (OAuth redirect + email links)
APP_BASE_URL="http://localhost:8787"

# Required in production for signing OAuth state cookies
AUTH_SECRET="change-me-to-a-long-random-string"

# Set to 0 to force-disable auth even if DATABASE_URL is set
# AUTH_ENABLED=1

# Session cookie
SESSION_COOKIE_NAME=numverse_session
# COOKIE_SECURE=1
# COOKIE_DOMAIN=

# Session TTL (seconds)
# SESSION_TTL_GUEST_SEC=604800
# SESSION_TTL_REGISTERED_SEC=2592000
# SESSION_TTL_ADMIN_SEC=28800

# Providers
# AUTH_GUEST_ENABLED=1
# AUTH_EMAIL_ENABLED=1
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://your.domain/api/v1/auth/google/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# DISCORD_REDIRECT_URI=https://your.domain/api/v1/auth/discord/callback

# Email (optional — without SMTP, links are logged to console / returned in non-prod)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
SMTP_FROM="NUMVERSE <noreply@example.com>"

# AUTH_SUCCESS_REDIRECT=/
